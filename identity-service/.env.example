# Copy to .env and fill in.

# Firebase project id (optional locally if ADC infers it; required in deploy).
FIREBASE_PROJECT_ID=
# Local creds: path to a service-account JSON (or use `gcloud auth application-default login`).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# WebAuthn relying party.
RP_ID=localhost
RP_NAME=Agentic Ordering Bot
EXPECTED_ORIGIN=http://localhost:5173

# TTLs (seconds).
CHALLENGE_TTL_SECONDS=300
LINK_CODE_TTL_SECONDS=600

# Shared secret the Telegram bot sends to /telegram/link/verify.
TELEGRAM_BOT_SECRET=

# Shared secret for /internal/* service-to-service calls (bot + agent).
# Falls back to TELEGRAM_BOT_SECRET when empty.
SERVICE_SECRET=

# Require a verified second factor (MFA) on protected endpoints.
REQUIRE_MFA=false
