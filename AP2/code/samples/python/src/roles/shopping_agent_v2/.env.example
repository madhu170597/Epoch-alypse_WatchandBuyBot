# Shopping agent config. Copy to .env (run.sh sources it) and fill in.

# Gemini model + credentials (provided separately).
# AGENT_MODEL=
# GOOGLE_API_KEY=
# or: GOOGLE_GENAI_USE_VERTEXAI=true  (+ GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION via ADC)

# MandateGuard gate (owned by separate service/team).
# Unset -> no payment can be approved (the client fails closed).
# MANDATE_GUARD_URL=https://mandateguard-xxxxx.run.app
# MANDATE_GUARD_TIMEOUT=45
# MG_AGENT_SA_KEY=/absolute/path/to/agent-sa-key.json        (never commit)
# MG_TRUSTED_SURFACE_SA_KEY=/absolute/path/to/trusted-sa-key.json  (never commit)
