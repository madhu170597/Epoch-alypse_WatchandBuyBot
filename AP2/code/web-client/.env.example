# Copy to .env.local (Vite) and fill in.

# Shopping agent A2A endpoint (default proxies /a2a to localhost:8080 in dev).
# VITE_AGENT_URL=
# VITE_MERCHANT_TRIGGER_URL=http://localhost:8081
VITE_IDENTITY_URL=http://localhost:8090

# Firebase web config (from Firebase console > Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
