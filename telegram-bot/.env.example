# Copy to .env and fill in.

# From @BotFather (the bot IS this token — keep it secret).
BOT_TOKEN=
# Random secret; webhook is served at /webhook/<WEBHOOK_SECRET>. (Webhook mode only.)
WEBHOOK_SECRET=
# Public URL of THIS bot service (Cloud Run / tunnel), for the MandateGuard webhook.
PUBLIC_BASE_URL=

# Identity service + the shared secret it expects (must match identity-service TELEGRAM_BOT_SECRET).
IDENTITY_URL=http://localhost:8090
TELEGRAM_BOT_SECRET=
# Shared secret for identity /internal/* calls (falls back to TELEGRAM_BOT_SECRET).
SERVICE_SECRET=
# Require the chat to be linked to a signed-in user before ordering (real-app mode).
ENFORCE_LINK=false

# Shopping agent A2A endpoint.
AGENT_URL=http://localhost:8080/a2a/shopping_agent
AGENT_TIMEOUT_SECONDS=120

# Web app URL for deep links.
WEB_APP_URL=http://localhost:5173

# Secret for the internal /notify endpoint.
NOTIFY_SECRET=

# ── MandateGuard (channel role) — needed only for the ESCALATE approval path ──
# Leave MANDATE_GUARD_URL empty to run the ALLOW-only demo (no operator action).
MANDATE_GUARD_URL=
# Path to the bot's channel service-account key JSON (for pull + redeem).
MG_CHANNEL_SA_KEY=
# Optional: MandateGuard decision-signer public key PEM (else fetched at runtime).
MG_EVENT_PUBLIC_PEM=

# Autonomous monitoring loop cadence / budget.
MONITOR_POLL_SECONDS=12
MONITOR_MAX_SECONDS=600
